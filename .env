# Server Configuration
NODE_ENV=development
PORT=3000
WS_PORT=3001
SERVER_ID=server-1

# Database
MONGODB_URI=mongodb://localhost:27017/realtime-backend

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug